<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Isola o app: só acessa a pasta Imagens e o que o usuário escolher. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Pasta padrão ~/Pictures/Capturador. -->
    <key>com.apple.security.assets.pictures.read-write</key>
    <true/>
    <!-- Salvar como…, Abrir imagem… e a pasta escolhida nos Ajustes. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Lembrar a pasta escolhida entre aberturas do app. -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
</dict>
</plist>
